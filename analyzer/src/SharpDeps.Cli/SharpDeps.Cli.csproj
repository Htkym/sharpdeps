<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpDeps.Cli</RootNamespace>
    <AssemblyName>SharpDeps.Cli</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharpdeps</ToolCommandName>
    <PackageId>SharpDeps.Cli</PackageId>
    <Version>0.4.0</Version>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Explicit trusted indexing and saved graph queries for SharpDeps.</Description>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <!-- Optimize first-call saved queries; this does not change query deadlines or library hosts. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="8" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" Publish="true" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <None Include="..\..\..\resources\icon.png" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="..\SharpDeps.Query\SharpDeps.Query.csproj" />
    <ProjectReference Include="..\SharpDeps.Analysis.Roslyn\SharpDeps.Analysis.Roslyn.csproj" />
    <ProjectReference Include="..\SharpDeps.Analysis.Markdown\SharpDeps.Analysis.Markdown.csproj" />
  </ItemGroup>
</Project>
