<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpDeps.Analysis.Roslyn</RootNamespace>
    <AssemblyName>SharpDeps.Analysis.Roslyn</AssemblyName>
    <Description>Roslyn/MSBuild semantic loading for SharpDeps (SD-003 prototype).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <!-- Required by MSBuildLocator's MSBL001 check: MSBuild must load from the SDK. -->
    <PackageReference
      Include="Microsoft.Build.Framework"
      ExcludeAssets="runtime"
      PrivateAssets="all" />
  </ItemGroup>

</Project>
