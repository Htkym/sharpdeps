<Project>

  <!--
    Central package versions for the analyzer solution. Versions are pinned from
    the SD-003 compatibility probe; see docs/adr/0001-semantic-loading.md and
    docs/compatibility.md before changing them.
  -->

  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!--
      Microsoft.Build.Framework must be referenced with ExcludeAssets="runtime"
      (MSBL001) so MSBuild assemblies are loaded from the located SDK instance.
      The version must match the transitive reference of Workspaces.MSBuild.
    -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
