<Project>

  <!--
    Central package versions for the analyzer solution. Quick and Semantic run
    in separate processes and use independently pinned Roslyn versions.
  -->

  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!--
      Quick uses syntax-only Roslyn and stays on the v0.0.4 parser version so its
      output is unchanged by the SD-005 split. Semantic uses the 5.9.0 series with
      MSBuild 18; the two run in separate processes.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!--
      Microsoft.Build.Framework must be referenced with ExcludeAssets="runtime"
      (MSBL001) so MSBuild assemblies are loaded from the located SDK instance.
      The version must match the transitive reference of Workspaces.MSBuild.
    -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
